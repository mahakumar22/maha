# ---------------------------------------------------------------------------
# Required. Supabase project settings -> API. Both are safe in the browser:
# row level security is what protects the data, not these keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Optional -- only needed for the daily email reminders. Without these the app
# runs normally and still stores reminder settings; it just does not send.
#
# These three are SECRET. Never prefix them with NEXT_PUBLIC_, never commit
# them: the service role key bypasses row level security entirely.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# The address reminders are sent from. Resend's shared onboarding@resend.dev
# only delivers to your own Resend account address; a verified domain lifts that.
REMINDER_FROM_EMAIL=Habit Tracker <onboarding@resend.dev>

# Link used inside the reminder email. Defaults to the request's own origin.
NEXT_PUBLIC_APP_URL=
